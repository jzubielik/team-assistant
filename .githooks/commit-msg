#!/usr/bin/env bash
# Commit message rules. Installed by make hooks.
#   1. No attribution lines, whichever tool or person they name: a line that starts with
#      "Co-Authored-By:" or with "Generated with" / "Generated by".
#   2. The subject follows Conventional Commits: type(scope)!: subject, at most 72 characters,
#      no trailing period. Merge, revert, fixup! and squash! subjects pass as git writes them.
set -euo pipefail
# Anchored to the start of a line (after signs such as an emoji), so the same words inside a
# sentence of the body pass.
attribution='^[^[:alnum:]]*(co-authored-by:|generated (with|by) )'
# Lines git strips (comments) do not count.
body=$(grep -v '^#' "$1" || :)
if hits=$(printf '%s\n' "$body" | grep -Ein "$attribution"); then
	echo "commit-msg: attribution line(s) are not allowed in this repository:" >&2
	printf '  %s\n' "$hits" >&2
	echo "Fix: remove the line(s) and commit again (your message is in .git/COMMIT_EDITMSG)." >&2
	exit 1
fi

subject=$(printf '%s\n' "$body" | sed -n '/[^[:space:]]/{p;q;}')
case "$subject" in
'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

types='feat|fix|docs|ci|build|chore|refactor|test|perf|revert'
problem=""
if [[ -z "$subject" ]]; then
	problem="the message is empty"
elif ! [[ "$subject" =~ ^($types)(\([a-z0-9._/-]+\))?!?:\ [^[:space:]] ]]; then
	problem="the subject is not 'type(scope)?!?: subject' with a known type"
elif ((${#subject} > 72)); then
	problem="the subject has ${#subject} characters (at most 72)"
elif [[ "$subject" == *. ]]; then
	problem="the subject ends with a period"
fi
[[ -z "$problem" ]] && exit 0

cat >&2 <<EOM
commit-msg: $problem:
  $subject

Conventional Commits: type(scope)?!?: subject
  types: feat fix docs ci build chore refactor test perf revert
  scope: optional, lowercase, e.g. (runner) (infra) (runbook); ! marks a breaking change
  subject: imperative, at most 72 characters, no trailing period
Examples:
  feat(agent): keep history per user and session
  fix(ops): refuse a deploy without ENV
  docs(runbook): explain make leaks
  build(runner)!: require Docker 29
Fix: git commit --amend (your message is in .git/COMMIT_EDITMSG).
EOM
exit 1
