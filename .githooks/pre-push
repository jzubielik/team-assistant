#!/usr/bin/env bash
# Refuse direct pushes to main (changes reach main through a pull request), then scan the
# commits being pushed for secrets and identifiers (.gitleaks.toml). Installed by make hooks.
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# ALLOW_MAIN_PUSH=1 git push ... overrides the main check (first push of a new remote,
# emergencies).
set -euo pipefail
scan="$(git rev-parse --show-toplevel)/scripts/gitleaks.sh"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	if [[ "$remote_ref" == refs/heads/main && "${ALLOW_MAIN_PUSH:-}" != 1 ]]; then
		echo "pre-push: refusing to push $local_ref to main directly: open a pull request." >&2
		echo "  Override: ALLOW_MAIN_PUSH=1 git push ..." >&2
		status=1
		continue
	fi
	[[ "$local_sha" =~ ^0+$ ]] && continue # deletion: nothing to scan
	if [[ "$remote_sha" =~ ^0+$ ]]; then
		# New branch: every commit not on any remote branch yet.
		range=("$local_sha" --not --remotes)
	else
		range=("$remote_sha..$local_sha")
	fi
	[[ -z "$(git rev-list "${range[@]}" | head -n 1)" ]] && continue
	echo "pre-push: scanning $local_ref -> $remote_ref (${range[*]})" >&2
	"$scan" log "${range[@]}" || status=1
done
if [[ $status -ne 0 ]]; then
	echo "pre-push: push refused; fix the commits above (git commit --amend or git rebase)." >&2
fi
exit "$status"
